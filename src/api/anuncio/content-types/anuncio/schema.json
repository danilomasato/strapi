{
  "kind": "collectionType",
  "collectionName": "anuncios",
  "info": {
    "singularName": "anuncio",
    "pluralName": "anuncios",
    "displayName": "Anuncio"
  },
  "options": {
    "draftAndPublish": true
  },
  "pluginOptions": {
    "i18n": {
      "localized": true
    }
  },
  "attributes": {
    "titulo": {
      "type": "string",
      "pluginOptions": {
        "i18n": {
          "localized": true
        }
      }
    },
    "descricao": {
      "type": "blocks",
      "pluginOptions": {
        "i18n": {
          "localized": true
        }
      }
    },
    "tipo": {
      "type": "relation",
      "relation": "manyToOne",
      "target": "api::tipo.tipo",
      "inversedBy": "anuncios"
    },
    "author": {
      "type": "relation",
      "relation": "oneToOne",
      "target": "api::author.author",
      "inversedBy": "anuncio"
    },
    "fotos": {
      "type": "media",
      "pluginOptions": {
        "i18n": {
          "localized": true
        }
      },
      "multiple": true,
      "allowedTypes": [
        "images",
        "files",
        "videos",
        "audios"
      ]
    },
    "Andar": {
      "type": "integer",
      "pluginOptions": {
        "i18n": {
          "localized": true
        }
      }
    },
    "Condominio": {
      "type": "customField",
      "pluginOptions": {
        "i18n": {
          "localized": true
        }
      },
      "customField": "plugin::superfields.tooltip-field",
      "options": {
        "tooltip-content": "Digite Somente o Valor",
        "description": "Digite Somente o Valor"
      }
    },
    "Tipo_de_Anuncio": {
      "type": "customField",
      "pluginOptions": {
        "i18n": {
          "localized": true
        }
      },
      "customField": "plugin::superfields.multi-select",
      "options": {
        "selectType": "multi",
        "nestedOptions": "[\n  {\n    \"label\": \"Group 1\",\n    \"value\": \"group1\",\n    \"children\": [\n      {\n        \"label\": \"Option A\",\n        \"value\": \"optA\"\n      },\n      {\n        \"label\": \"Option B\",\n        \"value\": \"optB\"\n      }\n    ]\n  },\n  {\n    \"label\": \"Group 2\",\n    \"value\": \"group2\"\n  }\n]",
        "enumValues": [
          "Venda",
          "Aluguel",
          "Venda e Aluguel"
        ],
        "tooltip-content": "Selecione o tipo anuncio"
      }
    }
  }
}

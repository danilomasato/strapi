        "i18n": {
          "localized": true
        }
      },
      "customField": "plugin::superfields.tooltip-field",
      "options": {
        "tooltip-content": "Digite o Valor do Terreno em m²",
        "description": "Digite o Valor do Terreno em m²"
      }
    },

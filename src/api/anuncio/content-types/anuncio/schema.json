      "type": "customField",
      "pluginOptions": {
        "i18n": {
          "localized": true
        }
      },
      "customField": "plugin::superfields.tooltip-field",
      "options": {
        "description": "Digite Somente o Valor da Venda (sem o R$)",
        "tooltip-content": ""
      }

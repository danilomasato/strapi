    "Valor_Aluguel": {
      "type": "customField",
      "pluginOptions": {
        "i18n": {
          "localized": true
        }
      },
      "customField": "plugin::superfields.tooltip-field",
      "options": {
        "tooltip-content": "",
        "description": "Digite Somente o Valor do Aluguel (sem o R$)"
      }

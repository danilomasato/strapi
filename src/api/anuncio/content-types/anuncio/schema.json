{
  "kind": "collectionType",
  "collectionName": "anuncios",
  "info": {
    "singularName": "anuncio",
    "pluralName": "anuncios",
    "displayName": "Anuncio"
  },
  "options": {
    "draftAndPublish": true
  },
  "pluginOptions": {
    "i18n": {
      "localized": true
    }
  },
  "attributes": {
    "titulo": {
      "type": "string",
      "pluginOptions": {
        "i18n": {
          "localized": true
        }
      }
    },
    "descricao": {
      "type": "blocks",
      "pluginOptions": {
        "i18n": {
          "localized": true
        }
      }
    },
    "author": {
      "type": "relation",
      "relation": "oneToOne",
      "target": "api::author.author",
      "inversedBy": "anuncio"
    },
    "fotos": {
      "type": "media",
      "pluginOptions": {
        "i18n": {
          "localized": true
        }
      },
      "multiple": true,
      "allowedTypes": [
        "images",
        "files",
        "videos",
        "audios"
      ]
    },
    "Tipo_de_Anuncio": {
      "type": "customField",
      "pluginOptions": {
        "i18n": {
          "localized": true
        }
      },
      "customField": "plugin::superfields.tooltip-enum-field",
      "options": {
        "enumValues": "venda\naluguel\nvenda e aluguel",
        "description": "Selecione o tipo de anuncio",
        "tooltip-content": "Selecione o tipo de anuncio"
      }
    },
    "Tipo_Residencia": {
      "type": "customField",
      "pluginOptions": {
        "i18n": {
          "localized": true
        }
      },
      "customField": "plugin::superfields.tooltip-enum-field",
      "options": {
        "tooltip-content": "Selecione o tipo de Residência ex: \"Apartamento, Casa, studio\"",
        "description": "Selecione o tipo de Residência ex: \"Apartamento, Casa, studio\"",
        "enumValues": "Apartamento Comercial\nApartamento Residencial\nCasa Residencial\nStudio"
      }
    },
    "Condominio": {
      "type": "customField",
      "pluginOptions": {
        "i18n": {
          "localized": true
        }
      },
      "customField": "plugin::superfields.tooltip-field",
      "options": {
        "tooltip-content": "Digite Somente o Valor",
        "description": "Digite Somente o Valor"
      }
    },
    "Andar": {
      "type": "integer",
      "pluginOptions": {
        "i18n": {
          "localized": true
        }
      }
    },
    "Ano_de_Construcao": {
      "type": "date",
      "pluginOptions": {
        "i18n": {
          "localized": true
        }
      }
    },
    "Area_Terreno": {
      "type": "customField",
      "pluginOptions": {
        "i18n": {
          "localized": true
        }
      },
      "customField": "plugin::superfields.tooltip-field",
      "options": {
        "tooltip-content": "Digite o Valor do Terreno em m²",
        "description": "Digite o Valor do Terreno em m²"
      }
    }
  }
}

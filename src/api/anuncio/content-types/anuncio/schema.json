{
  "kind": "collectionType",
  "collectionName": "anuncios",
  "info": {
    "singularName": "anuncio",
    "pluralName": "anuncios",
    "displayName": "Anuncio"
  },
  "options": {
    "draftAndPublish": true
  },
  "pluginOptions": {
    "i18n": {
      "localized": true
    }
  },
  "attributes": {
    "titulo": {
      "type": "string",
      "pluginOptions": {
        "i18n": {
          "localized": true
        }
      }
    },
    "descricao": {
      "type": "blocks",
      "pluginOptions": {
        "i18n": {
          "localized": true
        }
      }
    },
    "Andar": {
      "type": "customField",
      "pluginOptions": {
        "i18n": {
          "localized": true
        }
      },
      "customField": "plugin::superfields.tooltip-number-field",
      "options": {
        "numberType": "Integer",
        "description": "Use as setas para Cima/Baixo para escolher o Andar"
      },
      "default": 0
    },
    "Tipo_de_Anuncio": {
      "type": "customField",
      "pluginOptions": {
        "i18n": {
          "localized": true
        }
      },
      "customField": "plugin::superfields.tooltip-enum-field",
      "options": {
        "enumValues": "venda\naluguel\nvenda e aluguel\nLançamentos",
        "description": "Selecione o tipo de anuncio",
        "tooltip-content": "Selecione o tipo de anuncio"
      }
    },
    "Tipo_Residencia": {
      "type": "customField",
      "pluginOptions": {
        "i18n": {
          "localized": true
        }
      },
      "customField": "plugin::superfields.tooltip-enum-field",
      "options": {
        "tooltip-content": "Selecione o tipo de Residência ex: \"Apartamento, Casa, studio\"",
        "description": "Selecione o tipo de Residência ex: \"Apartamento, Casa, studio\"",
        "enumValues": "Apartamento Comercial\nApartamento Residencial\nCasa Residencial\nStudio"
      }
    },
    "Condominio": {
      "type": "customField",
      "pluginOptions": {
        "i18n": {
          "localized": true
        }
      },
      "customField": "plugin::superfields.tooltip-field",
      "options": {
        "tooltip-content": "Digite Somente o Valor",
        "description": "Digite Somente o Valor"
      }
    },
    "Ano_de_Construcao": {
      "type": "date",
      "pluginOptions": {
        "i18n": {
          "localized": true
        }
      }
    },
